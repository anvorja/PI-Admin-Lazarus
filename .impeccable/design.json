      "css": ".ds-btn-outline{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:16px;border:1px solid transparent;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s,transform .1s;background:var(--background);color:var(--foreground);border-color:var(--border);} .ds-btn-outline:hover{background:var(--muted);} .ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);} .ds-btn-outline:active{transform:translateY(1px);}"
    },
    {
      "name": "Botón destructivo",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Borrar, deshabilitar o cerrar el servicio con sesiones vivas.",
      "html": "<button class=\"ds-btn-halt\">Cerrar el servicio</button>",
      "css": ".ds-btn-halt{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:16px;border:1px solid transparent;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s,transform .1s;background:var(--halt-soft);color:var(--halt);} .ds-btn-halt:hover{background:color-mix(in oklch,var(--halt) 20%,transparent);} .ds-btn-halt:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);}"
    },
    {
      "name": "Botón de encendido",
      "kind": "custom",
      "refersTo": "power-button-open",
      "description": "El control del servicio en fase abierta, con anillo interior y pulso cuando hay sesiones.",
      "html": "<div class=\"ds-power\"><span class=\"ds-power-pulse\"></span><span class=\"ds-power-ring\"></span><button class=\"ds-power-btn\" aria-pressed=\"true\" aria-label=\"Cerrar el servicio\"><svg viewBox=\"0 0 24 24\" width=\"56\" height=\"56\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v10\"/><path d=\"M18.4 6.6a9 9 0 1 1-12.77.04\"/></svg></button></div>",
      "css": ".ds-power{position:relative;display:grid;place-items:center;width:224px;height:224px;} .ds-power-ring{position:absolute;inset:12px;border-radius:9999px;border:1px solid color-mix(in oklch,var(--signal) 45%,transparent);} .ds-power-pulse{position:absolute;inset:0;border-radius:9999px;border:1px solid var(--signal);animation:ds-pulse 2.4s ease-out infinite;} @keyframes ds-pulse{from{transform:scale(.86);opacity:.6}to{transform:scale(1.06);opacity:0}} .ds-power-btn{position:relative;display:grid;place-items:center;width:160px;height:160px;border-radius:9999px;border:1px solid color-mix(in oklch,var(--signal) 60%,transparent);background:var(--signal-soft);color:var(--signal);box-shadow:0 18px 50px -18px var(--signal);cursor:pointer;transition:background-color .5s cubic-bezier(0.16,1,0.3,1),border-color .5s cubic-bezier(0.16,1,0.3,1),box-shadow .5s cubic-bezier(0.16,1,0.3,1),transform .15s;} .ds-power-btn:active{transform:scale(.96);} .ds-power-btn:focus-visible{outline:2px solid var(--ring);outline-offset:4px;} @media (prefers-reduced-motion:reduce){.ds-power-pulse{display:none}}"
    },
    {
      "name": "Chips de estado",
      "kind": "chip",
      "refersTo": "chip-live",
      "description": "En sesión (con punto que late), Pendiente, Aprobado y Deshabilitado.",
      "html": "<span class=\"ds-chip ds-chip-live\"><span class=\"ds-dot\"></span>En sesión</span> <span class=\"ds-chip ds-chip-wait\">Pendiente</span> <span class=\"ds-chip ds-chip-muted\">Aprobado</span> <span class=\"ds-chip ds-chip-halt\">Deshabilitado</span>",
      "css": ".ds-chip{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:9999px;font-size:.75rem;font-weight:500;white-space:nowrap;} .ds-chip-live{background:var(--signal-soft);color:var(--signal);} .ds-chip-wait{background:var(--wait-soft);color:var(--wait);} .ds-chip-muted{background:var(--muted);color:var(--muted-foreground);} .ds-chip-halt{background:var(--halt-soft);color:var(--halt);} .ds-dot{width:6px;height:6px;border-radius:9999px;background:var(--signal);}"
    },
