  "components": [
    {
      "name": "Botón de tinta",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "Acción común sin estado: Guardar horario, Descargar .zip, Entrar.",
      "html": "<button class=\"ds-btn-ink\">Guardar horario</button>",
      "css": ".ds-btn-ink{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:16px;border:1px solid transparent;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s,transform .1s;background:var(--primary);color:var(--primary-foreground);} .ds-btn-ink:hover{background:color-mix(in oklch,var(--primary) 80%,transparent);} .ds-btn-ink:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);} .ds-btn-ink:active{transform:translateY(1px);}"
    },
    {
      "name": "Botón Aprobar",
      "kind": "button",
      "refersTo": "button-signal",
      "description": "Única acción en verde señal: aprobar un teléfono pendiente.",
      "html": "<button class=\"ds-btn-signal\">Aprobar</button>",
      "css": ".ds-btn-signal{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:16px;border:1px solid transparent;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s,transform .1s;height:32px;padding:0 12px;border-radius:12px;font-size:.8rem;background:var(--signal);color:var(--signal-fg);} .ds-btn-signal:hover{background:color-mix(in oklch,var(--signal) 85%,transparent);} .ds-btn-signal:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);} .ds-btn-signal:active{transform:translateY(1px);}"
    },
